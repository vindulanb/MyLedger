# Rust build output. Unanchored, so it also covers apps/web/target — the web
# app has its own target directory, being outside the workspace.
target/
**/*.rs.bk
*.pdb

# Built web app (the output of `dx build`)
/apps/web/dist/

# Environment / secrets
.env
.env.*
!.env.example

# Local runtime data — the SQLite database and uploaded documents
/data/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Editor / OS noise
.claude/settings.local.json
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
